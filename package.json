{
  "name": "helpinsights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node apps/api/main.ts",
    "lint": "prettier --check apps packages scripts/test-stack.ts tests playwright.config.ts package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:security": "node --test tests/security/*.test.ts",
    "test:stack": "node scripts/test-stack.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "prettier": "3.10.1"
  }
}
